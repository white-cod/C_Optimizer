{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "browser.chrome.cache",
      "name": "Google Chrome cache",
      "description": "Cached web pages, scripts and GPU data of all Google Chrome profiles. Cookies, passwords, history and bookmarks are not touched.",
      "category": "Browsers",
      "risk": "Safe",
      "scope": "PerUser",
      "closeProcesses": [
        "chrome"
      ],
      "targets": [
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnGraphiteCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnWebGPUCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\ShaderCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GrShaderCache"
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GraphiteDawnCache"
        }
      ]
    },
