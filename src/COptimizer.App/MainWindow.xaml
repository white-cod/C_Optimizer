<ui:FluentWindow
    x:Class="COptimizer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:COptimizer.App.ViewModels"
    xmlns:views="clr-namespace:COptimizer.App.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="C_Optimizer"
    Width="1120" Height="760" MinWidth="860" MinHeight="580"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="C_Optimizer" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12">
                <ui:Button
                    DockPanel.Dock="Bottom"
                    HorizontalAlignment="Stretch"
                    Appearance="Secondary"
                    Command="{Binding RestartAsAdministratorCommand}"
                    Content="Run as administrator"
                    Icon="{ui:SymbolIcon Shield24}"
                    ToolTip="Include system folders and the profiles of all users"
                    Visibility="{Binding ShowAdministratorBanner, Converter={StaticResource BoolToVisibility}}" />

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemContainerStyle>
                        <!-- Windows 11 style navigation item: subtle background and an accent indicator when selected. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Margin="0,2" Padding="12,9" Background="Transparent" CornerRadius="4">
                                            <Grid>
                                                <Rectangle
                                                    x:Name="Indicator"
                                                    Width="3"
                                                    Height="16"
                                                    Margin="-12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                    RadiusX="1.5"
                                                    RadiusY="1.5"
                                                    Visibility="Collapsed" />
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="{Binding Icon}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Page -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <DockPanel>
                    <ui:InfoBar
                        Margin="24,16,24,0"
                        DockPanel.Dock="Top"
                        IsClosable="True"
                        IsOpen="{Binding ShowAdministratorBanner, Mode=OneTime}"
                        Message="System folders and other users' profiles are skipped. Use 'Run as administrator' to include them."
                        Severity="Warning"
                        Title="Limited mode" />
                    <ContentControl Content="{Binding SelectedItem.Page}" Focusable="False" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
